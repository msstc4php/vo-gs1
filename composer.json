{
    "name": "msstc4php/vo-gs1",
    "description": "Value objects for GS1 identification keys, element strings, Digital Link and EPC URIs, medical-device UDI and NDC, and Russian and EU marking codes.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "gs1",
        "gtin",
        "ean",
        "upc",
        "sscc",
        "gln",
        "application-identifier",
        "gs1-128",
        "gs1-datamatrix",
        "digital-link",
        "epc",
        "udi",
        "hibc",
        "isbt-128",
        "ndc",
        "marking",
        "chestny-znak",
        "fmd",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/vo-base"
        }
    ],
    "require": {
        "msstc4php/vo-base": "^1.4",
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.76",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": ">=11.0",
        "rector/rector": "^2.1",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Gs1\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Gs1\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "extra": {
        "bundle-standard": {
            "kind": "library",
            "runtime": "php84"
        }
    }
}
